SEU-IP-ELASTICO-COM-HIFEN.sslip.io {
    encode gzip

    request_body {
        max_size 25MB
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /actuator/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /swagger-ui* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /v3/api-docs* {
        reverse_proxy 127.0.0.1:8080
    }

    handle {
        root * /var/www/fieldops
        try_files {path} /index.html
        file_server
    }
}

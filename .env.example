# ==============================================================================
# FieldOps — Variáveis de Ambiente (Docker Local & Migração para Nuvem AWS)
# ==============================================================================
# Copie este arquivo para ".env" antes de iniciar o ambiente com Docker Compose:
#   cp .env.example .env
# Nunca versione arquivos ".env" reais com credenciais de produção.

# --- PostgreSQL (Docker Compose Local) ----------------------------------------
POSTGRES_DB=fieldops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Backend Spring Boot (Local ou AWS ECS/Fargate / EC2) ---------------------
PORT=8080
# Para Docker local: jdbc:postgresql://localhost:5432/fieldops
# Para AWS RDS PostgreSQL:
# DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/fieldops?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/fieldops
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX_SIZE=15
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# --- Flyway (Migrações V1..V6 e Seed Repetível) ------------------------------
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=6

# --- Segurança JWT (Em produção AWS, injetar via AWS Secrets Manager) ---------
JWT_SECRET=FieldOpsDefaultSecureHmacSha256SecretKeyForDevAndTestEnv2026!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Armazenamento de Evidências (Local / AWS EFS ou Volume Persistente) ------
EVIDENCE_STORAGE_DIR=./data/evidences
EVIDENCE_MAX_FILE_SIZE_BYTES=10485760

# --- Utilitário db-seed (Para aplicar R__demo_seed_data.sql no AWS RDS) --------
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=prefer
